# AgentCut AI 环境变量配置模板
# 使用方法：复制本文件为 .env，填入你的真实 API Key

# ---------- VLM / ASR：SiliconFlow（硅基流动） ----------
# API Key 申请：https://cloud.siliconflow.cn/account/ak
AGENTCUT_VLM_BASE_URL=https://api.siliconflow.cn/v1
AGENTCUT_VLM_API_KEY=
AGENTCUT_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
AGENTCUT_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# ---------- LLM：DeepSeek ----------
# API Key 申请：https://platform.deepseek.com/
AGENTCUT_LLM_BASE_URL=https://api.deepseek.com
AGENTCUT_LLM_API_KEY=
AGENTCUT_LLM_MODEL=deepseek-v4-pro

# ---------- 模拟模式开关（可选） ----------
# 不设置：自动判断（两把 key 都配了就走真实模式；缺 key 的环节自动降级模拟）
# 设为 1：强制所有环节走模拟（忽略已配置的 key）
# 设为 0：强制走真实（key 缺失时对应环节会因认证失败报错）
# AGENTCUT_AI_SIMULATE=1

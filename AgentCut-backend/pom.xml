<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>cn.sutone</groupId>
    <artifactId>sutone-agent-cut</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>sutone-agent-cut</name>
    <description>AgentCut 视频智能剪辑后端（DDD 多模块）</description>

    <modules>
        <module>sutone-agent-cut-types</module>
        <module>sutone-agent-cut-api</module>
        <module>sutone-agent-cut-domain</module>
        <module>sutone-agent-cut-infrastructure</module>
        <module>sutone-agent-cut-app</module>
        <module>sutone-agent-cut-trigger</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块版本统一管理，后续业务依赖（MyBatis/Redis/RocketMQ 等）由对应 worker 在此补充 -->
            <dependency>
                <groupId>cn.sutone</groupId>
                <artifactId>sutone-agent-cut-types</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.sutone</groupId>
                <artifactId>sutone-agent-cut-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.sutone</groupId>
                <artifactId>sutone-agent-cut-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.sutone</groupId>
                <artifactId>sutone-agent-cut-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.sutone</groupId>
                <artifactId>sutone-agent-cut-app</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
